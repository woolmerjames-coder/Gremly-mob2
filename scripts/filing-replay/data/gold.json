  "guide_questions": [
    {
      "id": "d34",
      "question": "A closed Chapter takes a drop only when it looks back on what happened; the guide does not say whether a practical follow-up todo about the event (downloading race photos) counts as looking back or should go to the World."
    },
    {
      "id": "d37",
      "question": "The guide says sharing a place is not enough, but not whether an activity done during a Chapter that is mostly about another World (running while on the Lisbon trip) belongs to the Chapter or to its own World."
    },
    {
      "id": "d58",
      "question": "The guide does not say whether arrangements in another World made because of a Chapter (allotment watering while away) count as getting ready for that Chapter or stay in their own World."
    },
    {
      "id": "d45",
      "question": "The guide does not say whether household admin not tied to the flat or family (car insurance) falls under Home and family or belongs to no World; compare d50, filed to Home and family."
    },
    {
      "id": "d49",
      "question": "starts_something asks whether the drop could become a Chapter, but a Chapter sits inside one World; the guide does not say whether it can be true when no World fits."
    }
  ]
}