{
  "name": "gremly-mob2",
  "version": "1.0.0",
  "main": "index.ts",
  "engines": {
    "node": ">=20 <21"
  },
  "scripts": {
    "start": "expo start",
    "start:clean": "expo start -c",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "clean": "watchman watch-del-all || true && rm -rf $TMPDIR/metro-* && rm -rf node_modules/.cache && rm -rf android/app/build || true && rm -rf ios/Pods || true && rm -rf ios/DerivedData || true && rm -rf .expo",
    "lint": "eslint \"**/*.{js,jsx,ts,tsx}\"",
    "lint:fix": "eslint \"**/*.{js,jsx,ts,tsx}\" --fix",
    "typecheck": "tsc --noEmit",
  "test": "NODE_OPTIONS=--max-old-space-size=6144 jest --no-watchman --runInBand --detectOpenHandles --silent",
    "test:watch": "jest --watch",
    "ci": "npm run lint && npm run typecheck && npm run test",
    "prepare": "husky"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@react-navigation/bottom-tabs": "7.4.9",
    "@react-navigation/native": "7.1.18",
    "@react-navigation/native-stack": "7.3.28",
    "@supabase/supabase-js": "2.75.0",
    "date-fns": "4.1.0",
    "expo": "~54.0.13",
    "expo-status-bar": "~3.0.8",
    "lucide-react-native": "0.545.0",
    "nativewind": "^4",
    "react": "19.1.0",
    "react-native": "0.81.4",
    "react-native-actions-sheet": "0.9.7",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "3.0.0",
    "tailwind-merge": "3.3.1",
    "tailwind-variants": "3.1.1",
    "tailwindcss": "^3",
    "uuid": "13.0.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@babel/plugin-transform-export-namespace-from": "^7.27.1",
    "@babel/preset-typescript": "^7.27.1",
    "@eslint/js": "9.37.0",
    "@react-native/eslint-config": "^0.80.2",
    "@testing-library/jest-native": "5.4.3",
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "30.0.0",
    "@types/react": "~19.1.0",
    "@types/react-native": "^0.72.8",
    "@types/uuid": "10.0.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "babel-jest": "30.2.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-preset-expo": "^54.0.4",
    "eslint": "8.57.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jest": "^27.9.0",
    "eslint-plugin-react-hooks": "7.0.0",
    "globals": "16.4.0",
    "husky": "9.1.7",
    "identity-obj-proxy": "3.0.0",
    "jest": "30.2.0",
    "jest-expo": "54.0.12",
    "lint-staged": "15.5.2",
    "metro-react-native-babel-transformer": "0.77.0",
    "prettier": "3.6.2",
    "react-native-svg-transformer": "1.5.1",
    "react-native-worklets": "0.6.1",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^7.18.0"
  },
  "private": true,
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
