{
  "name": "gremly-mob2",
  "version": "1.0.0",
  "main": "index.ts",
  "engines": {
    "node": ">=20 <21"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "clean": "watchman watch-del-all || true && rm -rf $TMPDIR/metro-* && rm -rf node_modules/.cache && rm -rf android/app/build || true && rm -rf ios/Pods || true && rm -rf ios/DerivedData || true && rm -rf .expo",
    "start:clean": "npm run clean && expo start -c",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "ci": "npm run lint && npm run typecheck && npm run test",
    "prepare": "husky"
  },
  "dependencies": {
    "@react-native-masked-view/masked-view": "0.3.2",
    "@react-navigation/bottom-tabs": "7.4.9",
    "@react-navigation/native": "7.1.18",
    "@react-navigation/native-stack": "7.3.28",
    "expo": "~54.0.13",
    "expo-status-bar": "~3.0.8",
    "lucide-react-native": "0.545.0",
    "nativewind": "^2.0.11",
    "react": "19.1.0",
    "react-native": "0.81.4",
    "react-native-actions-sheet": "0.9.7",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "tailwind-merge": "3.3.1",
    "tailwind-variants": "3.1.1",
    "tailwindcss": "3.3.2"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@babel/plugin-transform-export-namespace-from": "^7.27.1",
    "@babel/preset-typescript": "^7.27.1",
    "@eslint/js": "9.37.0",
    "@react-native/eslint-config": "0.80.2",
    "@testing-library/jest-native": "5.4.3",
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "30.0.0",
    "@types/react": "~19.1.0",
    "@types/react-native": "^0.72.8",
    "babel-jest": "30.2.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-preset-expo": "^54.0.4",
    "eslint": "9.37.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.0.0",
    "globals": "16.4.0",
    "husky": "9.1.7",
    "jest": "30.2.0",
    "jest-expo": "54.0.12",
    "lint-staged": "15.5.2",
    "prettier": "3.6.2",
    "react-native-worklets": "0.6.1",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.46.1"
  },
  "private": true,
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
