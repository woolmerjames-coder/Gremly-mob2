    "eslint-plugin-react-hooks": "7.0.0",
    "eslint-plugin-regex": "1.10.0",
    "globals": "16.4.0",
    "husky": "9.1.7",
    "identity-obj-proxy": "3.0.0",
    "jest": "~29.7.0",
    "jest-expo": "54.0.13",
    "lint-staged": "15.5.2",
    "metro-react-native-babel-transformer": "0.77.0",
    "node-fetch": "3.3.2",
    "prettier": "3.6.2",
    "react-native-svg-transformer": "1.5.1",
