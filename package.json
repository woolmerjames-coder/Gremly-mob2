{
  "name": "gremly-mob2",
  "version": "1.0.0",
  "main": "index.ts",
  "engines": {
    "node": ">=20 <21"
  },
  "scripts": {
    "start": "expo start",
    "start:clean": "expo start -c",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "clean": "watchman watch-del-all || true && rm -rf $TMPDIR/metro-* && rm -rf node_modules/.cache && rm -rf android/app/build || true && rm -rf ios/Pods || true && rm -rf ios/DerivedData || true && rm -rf .expo",
    "lint": "eslint \"**/*.{js,jsx,ts,tsx}\"",
    "lint:fix": "eslint \"**/*.{js,jsx,ts,tsx}\" --fix",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:ci": "jest --ci",
    "test:watch": "jest --watch",
    "test:sql": "supabase test db supabase/tests",
    "test:minddrop": "jest app/screens/__tests__/CatchAllNotepad.flag.enabled.test.tsx app/screens/__tests__/CatchAllNotepad.flag.disabled.test.tsx",
    "eval:tags": "tsx artifacts/tags-eval/runEval.ts",
    "ci": "npm run lint && npm run typecheck && npm run test:ci && npm run check:repo && npm run check:schema",
    "ci:preflight": "bash scripts/ci-preflight.sh",
    "check:repo": "node scripts/check-direct-supabase.js",
    "check:schema": "node scripts/check-schema.mjs",
    "db:types": "bash scripts/gen_db_types.sh",
    "db:drift": "bash scripts/drift_check.sh",
    "diag:supa": "bash scripts/generate_supabase_diagnostics.sh",
    "analyze:drops": "tsx ./scripts/analyze-minddrop-logs.ts",
    "harness:classify": "tsx ./scripts/runClassificationHarness.ts",
    "prepare": "husky"
  },
