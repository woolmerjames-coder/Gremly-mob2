{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
  "types": ["jest", "react", "node"]
  },
  "include": ["**/*.ts", "**/*.tsx", "types", "__tests__/**/*"],
  "exclude": [
    "node_modules",
    "_archive/**/*",
    "gremly-chat-system-review/**/*",
    "gremly-handoff-jan26/**/*",
    "app/(dev)/**/*",
    "__tests__/pending/**/*",
    "supabase/functions/**/*",
    // Exclude generated bundles - they contain copied code with broken imports
    // relative to their location. These are distribution artifacts, not source.
    "artifacts/**/*",
    "scripts/**/*",
    // Exclude minddrop-reference - documentation/snippet files not meant to compile
    "minddrop-reference/**/*",
    // Exclude minddrop-voice-bundle - copied code with broken relative imports
    "minddrop-voice-bundle/**/*",
    // Exclude habit-sync-bundle - standalone bundle with broken relative imports
    "habit-sync-bundle/**/*",
    // Exclude aging-system-bundle - standalone bundle with broken relative imports
    "aging-system-bundle/**/*",
    // Exclude entity-chat-bundle - documentation bundle with copied code
    "entity-chat-bundle/**/*",
    // Exclude date-audit - temporary audit folder with stale imports
    "date-audit/**/*",
    // Exclude audit bundles - extracted zips with broken imports
    "classification-audit-bundle/**/*",
    "minddrop-audit-bundle/**/*",
    "minddrop-bundle/**/*",
    // Generic bundle pattern - all *-bundle directories
    "*-bundle/**/*",
    // Exclude notification context bundle - copied code with broken relative imports
    "gremly-notification-context/**/*"
  ]
}
