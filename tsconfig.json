{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "types": ["jest", "react"]
  },
  "include": ["**/*.ts", "**/*.tsx", "types", "__tests__/**/*"],
  "exclude": [
    "node_modules",
    "_archive/**/*",
    "gremly-chat-system-review/**/*",
    "app/(dev)/**/*",
    "__tests__/pending/**/*",
    "supabase/functions/**/*",
    "artifacts/**/*"
  ]
}
