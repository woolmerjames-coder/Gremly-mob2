{
  "expo": {
    "name": "Gremly",
    "slug": "gremly-mob2",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/mascot/ios_gremly_icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "gremly",
    "splash": {
      "image": "./assets/mascot/gremly-mascot.png",
      "resizeMode": "contain",
      "backgroundColor": "#BFD8C0"
    },
    "ios": {
      "icon": "./assets/mascot/ios_gremly_icon.png",
      "supportsTablet": false,
      "bundleIdentifier": "com.gremly.mob2",
      "buildNumber": "8",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "GIDClientID": "81105861621-ombuvivk9f9kifkoji8pgvnfsvstovqi.apps.googleusercontent.com",
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.81105861621-ombuvivk9f9kifkoji8pgvnfsvstovqi",
              "gremly",
              "com.gremly.mob2"
            ]
          }
        ],
        "NSCameraUsageDescription": "Gremly uses your camera to capture photos of notes, receipts, and moments you want to remember.",
        "NSPhotoLibraryUsageDescription": "Gremly accesses your photo library to add images to your notes and logs.",
        "NSMicrophoneUsageDescription": "Gremly uses your microphone for voice notes and audio capture.",
        "NSUserNotificationsUsageDescription": "Gremly sends reminders for your Morning Brief, Evening Sweep, and habit check-ins."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.gremly.mob2",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-apple-authentication",
      [
        "expo-notifications",
        {
          "icon": "./assets/mascot/ios_gremly_icon.png",
          "color": "#BFD8C0"
        }
      ]
    ],
    "extra": {
      "EXPO_PUBLIC_MIND_DROP_V2": "process.env.EXPO_PUBLIC_MIND_DROP_V2",
      "eas": {
        "projectId": "4c82fb8d-fdff-41a8-8fec-ce46ee3e6183"
      }
    }
  }
}
