# =============================================================================
# Gremly Environment Configuration
# =============================================================================
# Copy this file to .env.local and fill in your values
# All EXPO_PUBLIC_* variables are available at runtime in the app

# -----------------------------------------------------------------------------
# Supabase Configuration
# -----------------------------------------------------------------------------
# Required when EXPO_PUBLIC_REPO_BACKEND=supabase
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# Repository Backend
# -----------------------------------------------------------------------------
# Options: 'memory' | 'supabase'
# memory: In-memory storage (dev/testing)
# supabase: Production backend with Postgres + Auth
EXPO_PUBLIC_REPO_BACKEND=memory

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
# Options: 'on' | 'off' | 'true' | 'false'
# Defaults to 'on' unless explicitly set to 'off' or 'false'

# Spaces feature (Phase 8)
EXPO_PUBLIC_FEATURE_SPACES=on

# Unified overlay for create/edit (Phase 7)
EXPO_PUBLIC_UNIFIED_OVERLAY=on

# Habit buddy system (future feature)
EXPO_PUBLIC_FEATURE_BUDDY=off

# -----------------------------------------------------------------------------
# Today v2 Feature Flags (Phase 9)
# -----------------------------------------------------------------------------
# Smart suggestions (journal nudge, prep nudge, easy habit)
EXPO_PUBLIC_TODAY_SUGGESTIONS=on

# Celebration overlay on habit/todo completion
EXPO_PUBLIC_TODAY_CELEBRATION=on

# Evening reflection teaser (shows after 18:00)
EXPO_PUBLIC_TODAY_EVENING_TEASER=on

# -----------------------------------------------------------------------------
# Today v2 Dev Overrides (Phase 9)
# -----------------------------------------------------------------------------
# Force specific time window for manual QA
# Options: 'morning' | 'midday' | 'evening'
# Uncomment to override time-based features
# EXPO_PUBLIC_DEBUG_TODAY_TIMEWINDOW=morning

# -----------------------------------------------------------------------------
# Cortex AI Configuration
# -----------------------------------------------------------------------------
# AI proxy URL (required when AI features are used)
# Format: https://<your-project-ref>.supabase.co/functions/v1/cortex-proxy
EXPO_PUBLIC_CORTEX_URL=

# AI classification engine
# Options: 'LLM' | 'heuristic'
EXPO_PUBLIC_CORTEX_ENGINE=LLM

# OpenAI model to use
EXPO_PUBLIC_CORTEX_MODEL=gpt-4o-mini

# Auto-classify uncategorized items as catchall notes
EXPO_PUBLIC_CORTEX_CLASSIFY_CATCHALL=off

# Client-side timeout for cortex requests (milliseconds)
# NOTE: Server-side timeout is configured in Supabase Edge Function secrets
EXPO_PUBLIC_CORTEX_TIMEOUT_MS=12000

# Rate limiting window (seconds) - deprecated, now handled server-side
EXPO_PUBLIC_CORTEX_RATE_WINDOW_S=60

# Max requests per rate window - deprecated, now handled server-side
EXPO_PUBLIC_CORTEX_RATE_MAX=5

# Enable debug logging for Cortex
EXPO_PUBLIC_DEBUG_CORTEX=off

# -----------------------------------------------------------------------------
# Today v3 Feature Flags (Phase 10.9)
# -----------------------------------------------------------------------------
# Core Today v3 gate
EXPO_PUBLIC_TODAY_V3=on
# Today v3 focus card slice
EXPO_PUBLIC_TODAY_FOCUS_CARD=on
# Today v3 drop zone slice
EXPO_PUBLIC_TODAY_DROP_ZONE=on
# Today v3 sweep preview slice
EXPO_PUBLIC_TODAY_SWEEP_PREVIEW=on
# Evening Sweep v1 drawer + deck
EXPO_PUBLIC_EVENING_SWEEP_V1=on